{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Reading Room",
  "version": "1.2.0",
  "identifier": "com.daviddaniels.readingroom",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "The Reading Room",
        "width": 1180,
        "height": 820,
        "minWidth": 420,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' https: http:; frame-src https://www.youtube-nocookie.com; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "News",
    "shortDescription": "A private RSS reader",
    "copyright": "© 2026 David Daniels",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
