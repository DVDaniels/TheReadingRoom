<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the App Store version is allowed to do inside Apple's App Sandbox.
  TEAM_ID is filled in by the App Store workflow from the APPLE_TEAM_ID secret.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- download feeds and articles, show web pages -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- open and save OPML files you pick in a dialog -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>TEAM_ID.com.daviddaniels.readingroom</string>
  <key>com.apple.developer.team-identifier</key>
  <string>TEAM_ID</string>
</dict>
</plist>
